{
  "functions": {
    "api/consultor.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)\\.(js|css|json|geojson)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/fotos_radar/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|webp|svg|gif|ico|woff2|woff|ttf)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/artigos/:slug.html", "destination": "/artigo.html?slug=:slug" },
    { "source": "/artigos/:slug", "destination": "/artigo.html?slug=:slug" },
    { "source": "/artigo/:slug", "destination": "/artigo.html?slug=:slug" }
  ]
}