# =====================================================================
# RADAR SÃO JOSÉ DOS CAMPOS (SJC) - ENVIRONMENT VARIABLES CHECKLIST
# Configure estas variáveis no painel da Vercel (Project Settings > Environment Variables)
# =====================================================================

# ---------------------------------------------------------------------
# 1. GROQ CLOUD API (Inteligência Artificial & Consultor McKinsey)
# ---------------------------------------------------------------------
# Chave de API da plataforma Groq (Obrigatória para o Consultor IA /api/consultor.js)
# Onde encontrar: https://console.groq.com/keys
GROQ_API_KEY=

# Modelo LLM utilizado pela Groq (Opcional, padrão: qwen/qwen3.6-27b)
# Opções: qwen/qwen3.6-27b, llama-3.3-70b-versatile, deepseek-r1-distill-llama-70b
# Onde encontrar: https://console.groq.com/docs/models
GROQ_MODEL=

# ---------------------------------------------------------------------
# 2. SUPABASE (Banco de Dados PostgreSQL & Cloud Storage)
# ---------------------------------------------------------------------
# URL base do projeto Supabase (compatível com Serverless na Vercel)
# Onde encontrar: Supabase Dashboard > Project Settings > API > Project URL
SUPABASE_URL=https://tocyvysucpslayzglixq.supabase.co

# Chave pública/anônima (Publishable/Anon API Key) do Supabase
# Onde encontrar: Supabase Dashboard > Project Settings > API > Project API keys (anon/public)
SUPABASE_ANON_KEY=sb_publishable_8mKUf28dbMM8EOSPrgjRUA_19taJmrT

# Chave mestra / Service Role Key (Necessária para operações administrativas no Storage e RLS)
# Onde encontrar: Supabase Dashboard > Project Settings > API > Project API keys (service_role)
# ATENÇÃO: NUNCA exponha esta chave no frontend client-side; use apenas na Vercel e rotas /api/
SUPABASE_SERVICE_ROLE_KEY=

# Nome do Bucket de Storage no Supabase para Upload de Imagens de Capa e Rich Text
# Padrão: blog-images (Criado automaticamente via supabase_blog_schema.sql)
SUPABASE_STORAGE_BUCKET=blog-images

# ---------------------------------------------------------------------
# 3. CONFIGURAÇÕES DA API & SISTEMA VERCEL
# ---------------------------------------------------------------------
# Define se a API do consultor carrega obrigatoriamente a apresentação executiva (true/false)
REQUIRE_PRESENTATION=true

# Ambiente de execução (development | production)
NODE_ENV=production
